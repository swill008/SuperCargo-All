{
  "name": "supercargo",
  "version": "1.0.3",
  "description": "Star Citizen hauling manifest & cargo planning desktop app",
  "main": "./out/main/index.js",
  "author": "Travis",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/swill008/SuperCargo-All.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "test:replay": "electron-vite build && node test/replay/replay.mjs",
    "test:replay:logs": "electron-vite build && node test/replay/run_all.mjs",
    "test:fixtures": "python -I test/replay/make_fixture.py",
    "test:next-order": "node test/replay/next_order.mjs",
    "test:afk": "node test/replay/afk_checks.mjs",
    "test:refresh": "node test/replay/refresh_checks.mjs",
    "test:sanitize": "node test/replay/sanitize_checks.mjs",
    "test:where": "node test/replay/where_checks.mjs",
    "test:bodies": "node test/replay/bodies_checks.mjs",
    "test:logparse": "node test/replay/logparse_checks.mjs",
    "test:places": "node test/replay/places_checks.mjs",
    "test:spec": "node test/replay/spec_line_checks.mjs",
    "test:map": "node test/replay/map_covers_files_checks.mjs",
    "test:checks": "node -e \"const fs=require('fs'),cp=require('child_process');let bad=0;for(const f of fs.readdirSync('test/replay').filter(n=>n.endsWith('_checks.mjs'))){const r=cp.spawnSync(process.execPath,['test/replay/'+f],{stdio:'inherit'});if(r.status!==0){bad++;console.error('FAIL '+f)}}process.exit(bad?1:0)\"",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "gen:training": "node scripts/gen-training-data.mjs",
    "gen:atlas": "node scripts/build-glyph-atlas.mjs",
    "gen:icon": "node scripts/gen-icon.mjs",
    "gen:grids": "node scripts/gen-cargo-grids.mjs",
    "gen:uex": "node scripts/gen-uex-snapshots.mjs",
    "gen:other-positions": "node scripts/gen-other-positions.mjs",
    "markup": "vite --config tools/grid-markup/vite.config.ts",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "test:release": "node test/replay/release_checks.mjs",
    "test:update": "node test/replay/update_checks.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "electron-updater": "^6.3.9",
    "onnxruntime-node": "^1.27.0",
    "tesseract.js": "^5.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@fontsource/rajdhani": "^5.1.0",
    "@fontsource/saira": "^5.1.0",
    "@napi-rs/canvas": "^1.0.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  }
}
